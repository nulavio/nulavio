# Nulavio engine security fast path, local side (opt-in; not installed by anything).
# Every run: check Mozilla's Firefox releases (signatures verified), notify, and
# pre-build a release as soon as it is staged or published. It never commits,
# pushes, signs or publishes. See docs/architecture/update-policy.md ("Local timer").
#
# Needs ~/.config/nulavio-build/autobuild.env with one line:
#   NULAVIO_REPO=/path/to/your/nulavio/clone
# Enable it as your user (no root needed):
#   install -Dm644 contrib/systemd/nulavio-upstream.service contrib/systemd/nulavio-upstream.timer -t ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now nulavio-upstream.timer

[Unit]
Description=Nulavio: check Firefox releases and pre-build security updates
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/nulavio-build/autobuild.env
ExecStart=/usr/bin/python3 -I ${NULAVIO_REPO}/scripts/release/autobuild.py --notify
# 10 = ready to sign (not a failure). Other non-zero codes leave the unit
# "failed" on purpose, so `systemctl --user status` shows the problem.
SuccessExitStatus=10
Nice=10
IOSchedulingClass=idle
CPUWeight=20
TimeoutStartSec=5h
