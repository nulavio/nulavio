Subject: [PATCH] downloads: never open a program from the downloads UI (flow E)

Nulavio's build has no download-reputation check (R15: Google's download
protection is partner-only), so files that can run programs (AppImage,
shell scripts, packages, ...) get Nulavio's flow E instead: saved without
the execute bit, explained on a Nulavio page, and, with this patch, never
opened from the downloads panel or the Library. Their default action and a
click in the panel show the file in its folder (a click on one still
downloading no longer sets it to open when done), "Open" and "Always open similar files" are
unavailable, and the panel's status line says why. The file-type list lives
in a module of the branding directory (NulavioDownloads.sys.mjs), kept equal
to the Shell's by a test.

UX3C: retain a generic native warning triangle while the privacy-scoped
session list contains program items, independent of completion/attention
acknowledgement. Native warning/severe and progress are preserved. Removal
of the last eligible item clears the marker and supplemental description.

Owner: Nulavio maintainers
Upstream: not applicable (product policy).
---
--- a/browser/components/downloads/DownloadsViewUI.sys.mjs
+++ b/browser/components/downloads/DownloadsViewUI.sys.mjs
@@ -19,6 +19,7 @@
   DownloadsCommon:
     "moz-src:///browser/components/downloads/DownloadsCommon.sys.mjs",
   FileUtils: "resource://gre/modules/FileUtils.sys.mjs",
+  NulavioDownloads: "resource:///modules/nulavio/NulavioDownloads.sys.mjs",
   UrlbarShared: "chrome://browser/content/urlbar/UrlbarShared.mjs",
 });
 
@@ -763,7 +764,21 @@
           );
 
           let sizeWithUnits = DownloadsViewUI.getSizeWithUnits(this.download);
-          if (this.isPanel) {
+          // Nulavio (flow E): a program is shown in its folder, never opened from here.
+          let isProgram = lazy.NulavioDownloads.isProgram(this.download);
+          this.element.toggleAttribute("nulavio-program", isProgram);
+          if (this.isPanel && isProgram) {
+            let status = lazy.NulavioDownloads.statusLabel();
+            if (sizeWithUnits) {
+              status = lazy.DownloadsCommon.strings.statusSeparator(
+                status,
+                sizeWithUnits
+              );
+            }
+            this.showStatus(status, {
+              l10n: { id: "downloads-cmd-show-description-2" },
+            });
+          } else if (this.isPanel) {
             // In the Downloads Panel, we show the file size after the state
             // label, for example "Completed - 1.5 MB". When the pointer is over
             // the main area of the item, this label is replaced with a
@@ -1077,7 +1092,10 @@
       case lazy.DownloadsCommon.DOWNLOAD_PAUSED:
         return "downloadsCmd_pauseResume";
       case lazy.DownloadsCommon.DOWNLOAD_FINISHED:
-        return "downloadsCmd_open";
+        // Nulavio (flow E): a program is shown in its folder, never opened from here.
+        return lazy.NulavioDownloads.isProgram(this.download)
+          ? "downloadsCmd_show"
+          : "downloadsCmd_open";
       case lazy.DownloadsCommon.DOWNLOAD_BLOCKED_PARENTAL:
       case lazy.DownloadsCommon.DOWNLOAD_BLOCKED_CONTENT_ANALYSIS:
         return "downloadsCmd_openReferrer";
@@ -1121,7 +1139,11 @@
       case "downloadsCmd_open:window":
       case "downloadsCmd_alwaysOpenSimilarFiles":
         // This property is false if the download did not succeed.
-        return this.download.target.exists;
+        // Nulavio (flow E): programs are never opened from the downloads UI.
+        return (
+          this.download.target.exists &&
+          !lazy.NulavioDownloads.isProgram(this.download)
+        );
 
       case "downloadsCmd_show":
       case "downloadsCmd_deleteFile": {
--- a/browser/components/downloads/content/downloads.js
+++ b/browser/components/downloads/content/downloads.js
@@ -33,6 +33,7 @@
 );
 
 ChromeUtils.defineESModuleGetters(this, {
+  NulavioDownloads: "resource:///modules/nulavio/NulavioDownloads.sys.mjs",
   DownloadsViewUI:
     "moz-src:///browser/components/downloads/DownloadsViewUI.sys.mjs",
   FileUtils: "resource://gre/modules/FileUtils.sys.mjs",
@@ -976,6 +977,10 @@
       let command = "downloadsCmd_open";
       if (download.hasBlockedData) {
         command = "downloadsCmd_showBlockedInfo";
+      } else if (NulavioDownloads.isProgram(download)) {
+        // Nulavio (flow E): a program is shown in its folder, never opened (or
+        // set to open when done) from the panel.
+        command = "downloadsCmd_show";
       } else if (aEvent.shiftKey || aEvent.ctrlKey || aEvent.metaKey) {
         // We adjust the command for supported modifiers to suggest where the download
         // may be opened
@@ -1187,8 +1192,11 @@
       case "downloadsCmd_open:tabshifted":
       case "downloadsCmd_open:window":
       case "downloadsCmd_alwaysOpenSimilarFiles": {
-        if (!this.download.succeeded) {
-          return false;
+        if (
+          !this.download.succeeded ||
+          NulavioDownloads.isProgram(this.download)
+        ) {
+          return false; // Nulavio (flow E): programs are never opened from the panel
         }
 
         let file = new FileUtils.File(this.download.target.path);
--- a/browser/components/downloads/DownloadsCommon.sys.mjs
+++ b/browser/components/downloads/DownloadsCommon.sys.mjs
@@ -39,6 +39,7 @@
   DownloadsTaskbar:
     "moz-src:///browser/components/downloads/DownloadsTaskbar.sys.mjs",
   NetUtil: "resource://gre/modules/NetUtil.sys.mjs",
+  NulavioDownloads: "resource:///modules/nulavio/NulavioDownloads.sys.mjs",
   PlacesUtils: "resource://gre/modules/PlacesUtils.sys.mjs",
   PrivateBrowsingUtils: "resource://gre/modules/PrivateBrowsingUtils.sys.mjs",
 });
@@ -1475,6 +1476,17 @@
   _updateView(aView) {
     aView.hasDownloads = this._hasDownloads;
     aView.percentComplete = this._percentComplete;
+    // UX3C: a type warning for retained session-list items, in this privacy scope.
+    // Completion, cancellation and failure do not dismiss it; removal does.
+    // The indicator's WeakMap can retain old keys while it has no views (e.g.
+    // after the last private window closes). DownloadsData stays linked to the
+    // real list, so removals made while no indicator is attached are respected.
+    let downloads = this._isPrivate
+      ? lazy.PrivateDownloadsData._downloads
+      : lazy.DownloadsData._downloads;
+    aView.hasPrograms = downloads.some(download =>
+      lazy.NulavioDownloads.isProgram(download)
+    );
     aView.attention =
       this.attentionSuppressed !== DownloadsCommon.SUPPRESS_NONE
         ? DownloadsCommon.ATTENTION_NONE
--- a/browser/components/downloads/content/indicator.js
+++ b/browser/components/downloads/content/indicator.js
@@ -24,6 +24,10 @@

 "use strict";

+ChromeUtils.defineESModuleGetters(this, {
+  NulavioDownloads: "resource:///modules/nulavio/NulavioDownloads.sys.mjs",
+});
+
 // DownloadsButton

 /**
@@ -293,6 +297,7 @@
     // Reset the view properties, so that a neutral indicator is displayed if we
     // are visible only temporarily as an anchor.
     this.percentComplete = 0;
+    this.hasPrograms = false;
     this.attention = DownloadsCommon.ATTENTION_NONE;
   },

@@ -532,26 +537,67 @@
     }
   },

+  // UX3C is persistent list state, separate from Gecko's dismissible attention.
+  set hasPrograms(aValue) {
+    this._hasPrograms = aValue;
+    if (this._operational) {
+      this._refreshAttention();
+    }
+  },
+  _hasPrograms: false,
+
   _refreshAttention() {
     // Check if the downloads button is in the menu panel, to determine which
     // button needs to get a badge.
     let widgetGroup = CustomizableUI.getWidget("downloads-button");
     let inMenu = widgetGroup.areaType == CustomizableUI.TYPE_PANEL;

+    let attention = this._attention;
+    if (
+      this._hasPrograms &&
+      attention != DownloadsCommon.ATTENTION_WARNING &&
+      attention != DownloadsCommon.ATTENTION_SEVERE
+    ) {
+      attention = DownloadsCommon.ATTENTION_WARNING;
+    }
+    this.indicator.toggleAttribute("nulavio-program", this._hasPrograms);
+    // Append a description; keep the native name, tooltip and any other description.
+    const id = "nulavio-downloads-program-description";
+    let description = document.getElementById(id);
+    let refs = (this.indicator.getAttribute("aria-describedby") || "")
+      .split(/\s+/).filter(ref => ref && ref != id);
+    if (this._hasPrograms) {
+      if (!description) {
+        description = document.createXULElement("description");
+        description.id = id;
+        description.hidden = true;
+        document.documentElement.appendChild(description);
+      }
+      description.textContent = NulavioDownloads.indicatorLabel();
+      refs.push(id);
+    } else {
+      description?.remove();
+    }
+    if (refs.length) {
+      this.indicator.setAttribute("aria-describedby", refs.join(" "));
+    } else {
+      this.indicator.removeAttribute("aria-describedby");
+    }
+
     // For arrow-Styled indicator, suppress success attention if we have
     // progress in toolbar
     let suppressAttention =
       !inMenu &&
-      this._attention == DownloadsCommon.ATTENTION_SUCCESS &&
+      attention == DownloadsCommon.ATTENTION_SUCCESS &&
       this._percentComplete >= 0;

     if (
       suppressAttention ||
-      this._attention == DownloadsCommon.ATTENTION_NONE
+      attention == DownloadsCommon.ATTENTION_NONE
     ) {
       this.indicator.removeAttribute("attention");
     } else {
-      this.indicator.setAttribute("attention", this._attention);
+      this.indicator.setAttribute("attention", attention);
     }
   },
   _attention: DownloadsCommon.ATTENTION_NONE,
