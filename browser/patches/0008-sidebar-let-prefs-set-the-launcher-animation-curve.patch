Subject: [PATCH] sidebar: let prefs set the launcher animation curve and collapse time

UX3F (QA A5/M4): the launcher animation used a fixed "ease-in-out" for 200 ms
in both directions, so nothing moved in the first ~50 ms and collapsing felt
as slow as expanding. Two prefs, both read lazily:

- sidebar.animation.easing: a CSS easing string; an invalid value falls
  back to the engine's "ease-in-out".
- sidebar.animation.collapse-duration-ms: the duration when the launcher
  narrows; sidebar.animation.duration-ms keeps the expand duration.

Nulavio sets cubic-bezier(0.2, 0, 0, 1) (its standard motion token), 220 ms
to expand and 160 ms to collapse in firefox-branding.js. Reduced motion still
skips the animation entirely (gReduceMotion, unchanged).

Owner: Nulavio maintainers
Upstream: not applicable (product look).
---
--- a/browser/components/sidebar/browser-sidebar.js
+++ b/browser/components/sidebar/browser-sidebar.js
@@ -1415,11 +1415,21 @@
     });
     let toRects = this._getRects(animatingElements);
 
+    // Nulavio: collapsing is quicker than expanding, and the curve is a pref
+    // (an invalid value falls back to the engine's own curve).
+    const collapsing = toRects[0][1].width < fromRects[0][1].width;
+    let easing = "ease-in-out";
+    try {
+      new KeyframeEffect(null, null, { easing: this._animationEasing });
+      easing = this._animationEasing;
+    } catch {}
     const options = {
       duration: document.documentElement.hasAttribute("sidebar-expand-on-hover")
         ? this._animationExpandOnHoverDurationMs
-        : this._animationDurationMs,
-      easing: "ease-in-out",
+        : collapsing
+          ? this._animationCollapseDurationMs
+          : this._animationDurationMs,
+      easing,
     };
     let animations = [];
     let sidebarOnLeft = this._positionStart != RTL_UI;
@@ -2878,6 +2888,18 @@
 );
 XPCOMUtils.defineLazyPreferenceGetter(
   SidebarController,
+  "_animationCollapseDurationMs",
+  "sidebar.animation.collapse-duration-ms",
+  200
+);
+XPCOMUtils.defineLazyPreferenceGetter(
+  SidebarController,
+  "_animationEasing",
+  "sidebar.animation.easing",
+  "ease-in-out"
+);
+XPCOMUtils.defineLazyPreferenceGetter(
+  SidebarController,
   "_animationExpandOnHoverDurationMs",
   "sidebar.animation.expand-on-hover.duration-ms",
   400
