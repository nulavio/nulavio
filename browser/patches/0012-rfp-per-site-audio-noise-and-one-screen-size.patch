 // static
+void nsRFPService::RandomizeAudioSamples(
+    nsICookieJarSettings* aCookieJarSettings, float* aData, uint32_t aLength) {
+  if (!aCookieJarSettings || !aData || aLength < 2) {
+    return;
+  }
+
+  // The key the canvas noise uses for an image, made here from the samples.
+  // It fails when the site has no randomization key, and then nothing is
+  // changed.
+  nsTArray<uint8_t> key;
+  // (The size is a uint32_t there: a rendering of 2^30 samples or more gives
+  // the key its first 4 GiB less one byte, never a wrapped size.)
+  const uint64_t bytes = uint64_t(aLength) * sizeof(float);
+  nsresult rv = GenerateCanvasKeyFromImageData(
+      aCookieJarSettings, reinterpret_cast<uint8_t*>(aData),
+      static_cast<uint32_t>(std::min<uint64_t>(bytes, UINT32_MAX)), key);
+  if (NS_FAILED(rv) || key.Length() < 16) {
+    return;
+  }
+
+  non_crypto::XorShift128PlusRNG rng(
+      *reinterpret_cast<uint64_t*>(key.Elements()),
+      *reinterpret_cast<uint64_t*>(key.Elements() + 8));
+
+  // A different step for every sample, so that the ratio of two samples
+  // moves too: one factor for the whole buffer could be divided out.
+  for (uint32_t i = 0; i < aLength; ++i) {
+    const int32_t step = static_cast<int32_t>(rng.next() & 0xFFFF) - 0x8000;
+    aData[i] *= 1.0f + static_cast<float>(step) * (1.0e-4f / 32768.0f);
+  }
+}
+
+// static
