+// Nulavio: the noise itself, from the two halves of a seed that the callers
+// below make of the site's key and the samples.
+static void MoveAudioSamples(uint64_t aSeed0, uint64_t aSeed1, float* aData,
+                             uint32_t aLength) {
+  non_crypto::XorShift128PlusRNG rng(aSeed0, aSeed1);
+
+  // A different step for every sample, so that the ratio of two samples
+  // moves too: one factor for the whole buffer could be divided out.
+  for (uint32_t i = 0; i < aLength; ++i) {
+    const int32_t step = static_cast<int32_t>(rng.next() & 0xFFFF) - 0x8000;
+    aData[i] *= 1.0f + static_cast<float>(step) * (1.0e-4f / 32768.0f);
+  }
+}
+
