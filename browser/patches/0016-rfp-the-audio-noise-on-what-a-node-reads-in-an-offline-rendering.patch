+// Nulavio: see AudioContext::AudioNoiseKey().
+static nsTArray<uint8_t> AudioNoiseKeyFor(nsPIDOMWindowInner* aWindow,
+                                          bool aIsOffline) {
+  nsTArray<uint8_t> key;
+  Document* doc = aIsOffline ? aWindow->GetExtantDoc() : nullptr;
+  if (doc && doc->ShouldResistFingerprinting(RFPTarget::AudioRandomization) &&
+      NS_FAILED(
+          doc->CookieJarSettings()->GetFingerprintingRandomizationKey(key))) {
+    // The site has no key: the protection is off for it.
+    key.Clear();
+  }
+  return key;
+}
