+// static
+void nsRFPService::RandomizeAudioSamplesWithKey(
+    const nsTArray<uint8_t>& aSiteKey, float* aData, uint32_t aLength) {
+  // Three 64-bit words of the key are read; a site's key has four.
+  uint64_t words[3];
+  if (aSiteKey.Length() < sizeof(words) || !aData || !aLength) {
+    return;
   }
+  memcpy(words, aSiteKey.Elements(), sizeof(words));
+
+  // The seed GenerateCanvasKeyFromImageData makes for a small image: a hash
+  // of the data, scrambled with the first half of the site's key, and spread
+  // with its third word. Unlike that function it reads no cookie jar
+  // settings and no pref, and it allocates nothing: a worklet's inputs come
+  // through here on the rendering thread, one block at a time.
+  const mozilla::HashNumber dataHash =
+      mozilla::HashBytes(aData, size_t(aLength) * sizeof(float));
+  const mozilla::HashNumber scrambled =
+      mozilla::HashCodeScrambler(words[0], words[1]).scramble(dataHash);
+  non_crypto::XorShift128PlusRNG spread(
+      static_cast<uint64_t>(scrambled) << 32 | dataHash, words[2]);
+  const uint64_t seed0 = spread.next();
+  const uint64_t seed1 = spread.next();
+  MoveAudioSamples(seed0, seed1, aData, aLength);
 }
 
