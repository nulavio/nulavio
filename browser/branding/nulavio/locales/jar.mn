# "%" marks localized files: en-US/ in this directory for English, and
# <L10NBASEDIR>/<locale>/browser/branding/nulavio/ for other locales
# (Nulavio provides those in browser/l10n/, see fetch_firefox_l10n.py).
[localization] @AB_CD@.jar:
  branding                                          (%*.ftl)

@AB_CD@.jar:
% locale branding @AB_CD@ %locale/branding/
  locale/branding/brand.properties (%brand.properties)
