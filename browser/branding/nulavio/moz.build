# "shell" is the Nulavio Shell built-in add-on, generated by scripts/build/make_shell.py.
DIRS += ["content", "locales", "shell"]

# Smart Profile Routing: a command-line handler that runs before the browser's,
# and the hook the address bar calls before loading (patch 0005).
EXTRA_JS_MODULES.nulavio += ["NulavioCommandLine.sys.mjs", "NulavioUrlbarRouting.sys.mjs"]
XPCOM_MANIFESTS += ["components.conf"]

DIST_SUBDIR = "browser"
export("DIST_SUBDIR")

include("../branding-common.mozbuild")
FirefoxBranding()
