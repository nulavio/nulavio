browser.jar:
% content branding %content/branding/ contentaccessible=yes
  content/branding/about.png
  content/branding/about-logo.png
  content/branding/about-logo.svg
  content/branding/about-logo@2x.png
  content/branding/about-wordmark.svg
  content/branding/about-logo-private.png
  content/branding/about-logo-private@2x.png
  content/branding/document.ico                  (../document.ico)
  content/branding/document_pdf.svg
  content/branding/firefox-wordmark.svg
  content/branding/icon16.png                    (../default16.png)
  content/branding/icon32.png                    (../default32.png)
  content/branding/icon48.png                    (../default48.png)
  content/branding/icon64.png                    (../default64.png)
  content/branding/icon128.png                   (../default128.png)
  content/branding/aboutDialog.css
# UX3F A2: Nulavio's own artwork instead of the engine's "Kit" fox on promo cards
  content/branding/illustration-promo.svg       (illustration-promo.svg)
% override chrome://global/skin/illustrations/kit-happy.svg chrome://branding/content/illustration-promo.svg
% override chrome://global/skin/illustrations/kit-concerned.svg chrome://branding/content/illustration-promo.svg
% override chrome://global/skin/illustrations/kit-confetti.svg chrome://branding/content/illustration-promo.svg
% override chrome://global/skin/illustrations/kit-holding-lock.svg chrome://branding/content/illustration-promo.svg
% override chrome://global/skin/illustrations/kit-in-circle.svg chrome://branding/content/illustration-promo.svg
% override chrome://global/skin/illustrations/kit-sympathetic.svg chrome://branding/content/illustration-promo.svg
# UX3H M-1: the same artwork instead of the fox on about:addons' empty list and
# about:logins / the passwords panel.
% override chrome://mozapps/skin/extensions/kit-addons.svg chrome://branding/content/illustration-promo.svg
% override chrome://mozapps/skin/extensions/kit-themes.svg chrome://branding/content/illustration-promo.svg
% override chrome://global/content/megalist/icons/cpm-fox-illustration.svg chrome://branding/content/illustration-promo.svg
# UX3G N2: Nulavio's shield on the Settings privacy status, a neutral account
# icon instead of Mozilla's logo, and the Nulavio glyph instead of the Firefox
# logo on "About Nulavio". Artwork only; no behaviour changes.
  content/branding/illustration-shield-ok.svg    (illustration-shield-ok.svg)
  content/branding/illustration-shield-alert.svg (illustration-shield-alert.svg)
  content/branding/nulavio-glyph-16.svg          (nulavio-glyph-16.svg)
% override chrome://global/skin/illustrations/shield-check.svg chrome://branding/content/illustration-shield-ok.svg
% override chrome://global/skin/illustrations/shield-alert.svg chrome://branding/content/illustration-shield-alert.svg
% override chrome://browser/skin/preferences/mozilla-logo.svg chrome://browser/skin/fxa/avatar-empty.svg
% override chrome://browser/skin/preferences/mozilla-16.svg chrome://browser/skin/fxa/avatar-empty.svg
% override chrome://browser/skin/sidebar/firefox.svg chrome://branding/content/nulavio-glyph-16.svg
# Nulavio Horizon window theme (loaded by browser.xhtml, browser/patches/0003)
  content/branding/theme/tokens.css              (theme/tokens.css)
  content/branding/theme/horizon.css             (theme/horizon.css)
