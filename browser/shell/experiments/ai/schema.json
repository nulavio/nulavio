      {
        "name": "assistantConfigure",
        "type": "function",
        "async": true,
        "parameters": [
          {
            "name": "details",
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "openai",
                  "anthropic"
                ]
              },
              "baseUrl": {
                "type": "string",
                "maxLength": 2048
              },
              "model": {
                "type": "string",
                "maxLength": 200
              },
              "label": {
                "type": "string",
                "optional": true,
                "maxLength": 60
              },
              "key": {
                "type": "string",
                "optional": true,
                "maxLength": 512
              }
            }
          }
        ]
      },
      {
        "name": "assistantAllow",
        "type": "function",
