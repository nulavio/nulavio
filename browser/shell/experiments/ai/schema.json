      },
      {
        "name": "add",
        "type": "function",
        "async": true,
        "parameters": [
          {
            "name": "details",
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 48
              },
              "client": {
                "type": "string",
                "enum": [
                  "claude-code",
                  "codex",
                  "other"
                ]
              },
              "autonomy": {
                "type": "string",
                "enum": [
                  "restricted",
                  "assisted",
                  "autonomous",
                  "full_control"
                ]
              },
              "domains": {
                "type": "array",
                "optional": true,
                "items": {
                  "type": "string",
                  "maxLength": 253
                },
                "maxItems": 50
              },
              "disposable": {
                "type": "boolean",
                "optional": true
              },
              "acceptFullControl": {
                "type": "boolean",
                "optional": true
              }
            }
          }
        ]
      },
      {
        "name": "change",
        "type": "function",
        "async": true,
        "parameters": [
          {
            "name": "agent",
            "type": "string",
            "maxLength": 32
          },
          {
            "name": "op",
            "type": "string",
            "enum": [
              "autonomy",
              "grant",
              "clear-grant",
              "raw-automation",
              "domains",
              "profiles",
              "routes",
              "pause",
              "revoke",
              "remove",
              "rotate-token"
            ]
          },
          {
            "name": "details",
            "type": "object",
            "optional": true,
            "additionalProperties": {
              "type": "any"
            }
          }
        ]
      },
      {
        "name": "setStopped",
        "type": "function",
        "async": true,
        "parameters": [
          {
            "name": "stopped",
            "type": "boolean"
          }
        ]
      },
      {
        "name": "activity",
        "type": "function",
        "async": true,
        "parameters": [
          {
            "name": "limit",
            "type": "integer",
            "optional": true,
            "minimum": 1,
            "maximum": 500
          },
          {
            "name": "agent",
            "type": "string",
            "optional": true,
            "maxLength": 32
          }
        ]
      },
      {
        "name": "clearActivity",
        "type": "function",
        "async": true,
