              "rawText": {
                "type": "string",
                "maxLength": 400
              },
              "pausedText": {
                "type": "string",
                "maxLength": 400
              },
              "failedText": {
                "type": "string",
                "maxLength": 400
              },
              "stopLabel": {
                "type": "string",
                "maxLength": 60
              }
            }
          }
        ]
      },
