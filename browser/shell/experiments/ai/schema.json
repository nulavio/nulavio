              "codex"
            ]
          }
        ]
      },
      {
        "name": "install",
        "type": "function",
        "async": true,
        "parameters": [
          {
            "name": "agent",
            "type": "string",
            "maxLength": 32
          },
          {
            "name": "client",
            "type": "string",
            "enum": [
              "claude-code",
              "codex"
            ]
          },
