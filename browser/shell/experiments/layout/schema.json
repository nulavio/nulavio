[
  {
    "namespace": "nulavioLayout",
    "description": "Native layout presets and one-time first-run choice in the current profile (D-UX2). Built-in Shell only; no generic preference writer.",
    "functions": [
      { "name": "state", "type": "function", "async": true, "parameters": [] },
      {
        "name": "apply", "type": "function", "async": true,
        "parameters": [{ "name": "preset", "type": "string", "enum": ["lateral", "top", "focus"] }]
      },
      { "name": "dismissChoice", "type": "function", "async": true, "parameters": [] },
      {
        "name": "toggleFocus", "type": "function", "async": true,
        "parameters": [{ "name": "tabId", "type": "integer", "minimum": 0 }]
      },
      {
        "name": "setImmersive", "type": "function", "async": true,
        "parameters": [
          { "name": "on", "type": "boolean", "optional": true },
          { "name": "tabId", "type": "integer", "minimum": 0, "optional": true }
        ]
      }
    ],
    "events": [{ "name": "onChanged", "type": "function", "parameters": [] }]
  }
]
