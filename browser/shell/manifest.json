{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "shell@nulavio.net",
      "strict_min_version": "140.0"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "permissions": ["downloads", "management", "privacy", "search"],
  "incognito": "spanning",
  "icons": {
    "48": "shared/nulavio-symbol.svg",
    "96": "shared/nulavio-symbol.svg"
  }
}
