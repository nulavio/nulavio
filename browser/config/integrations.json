{
  "$comment": "Nulavio Connect P0 (docs/adr/0004-nulavio-connect.md). Read by the launcher (nulavio integrations) and by the Shell (Settings > Integrations). Discovery is read-only and uses only these official protocols: D-Bus name ownership and properties, the freedesktop default-application settings, and files the integration itself installs.",
  "version": 1,
  "integrations": [
    {
      "id": "plasma-browser-integration",
      "priority": "P0",
      "nativeHost": "org.kde.plasma.browser_integration",
      "extension": "plasma-browser-integration@kde.org",
      "extensionPage": "https://addons.mozilla.org/firefox/addon/plasma-integration/",
      "session": "org.kde.plasmashell"
    },
    {
      "id": "xdg-portals",
      "priority": "P0",
      "busName": "org.freedesktop.portal.Desktop",
      "objectPath": "/org/freedesktop/portal/desktop",
      "interfaces": ["FileChooser", "OpenURI", "ScreenCast", "Notification", "Settings"]
    },
    {
      "id": "secret-service",
      "priority": "P0",
      "busName": "org.freedesktop.secrets",
      "related": ["org.kde.kwalletd6", "org.kde.kwalletd5"]
    },
    {
      "id": "default-browser",
      "priority": "P0",
      "types": ["x-scheme-handler/http", "x-scheme-handler/https", "text/html"],
      "nulavioDesktopIds": ["net.nulavio.Nulavio.desktop", "nulavio-preview.desktop"]
    }
  ]
}
